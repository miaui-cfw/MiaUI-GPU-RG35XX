+/**
+ * @brief Input handler event: records KEY_POWER from any input device in current_power_key_value.
+ * @param handle The handle.
+ * @param type Event type.
+ * @param code Event code.
+ * @param value Event value.
+ */
+static void atc260x_event(struct input_handle *handle, unsigned int type, unsigned int code, int value)
+{
+	if (type == EV_KEY && code == KEY_POWER)
+		current_power_key_value = value;
+}
+
+/**
+ * @brief Input handler connect: opens every input device (the handle is named "evbug", as in the original).
+ * @param handler This handler.
+ * @param dev The input device.
+ * @param id The matching id (unused).
+ * @return 0, or a negative errno.
+ */
+static int atc260x_connect(struct input_handler *handler, struct input_dev *dev,
+			   const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int error;
+
+	handle = kzalloc(sizeof(struct input_handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "evbug";
+
+	error = input_register_handle(handle);
+	if (error)
+		goto err_free_handle;
+
+	error = input_open_device(handle);
+	if (error)
+		goto err_unregister_handle;
+
+	return 0;
+
+err_unregister_handle:
+	input_unregister_handle(handle);
+err_free_handle:
+	kfree(handle);
+	return error;
+}
+
+/**
+ * @brief Input handler disconnect: closes and frees the handle.
+ * @param handle The handle.
+ */
+static void atc260x_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+/* Matches every input device. */
+static const struct input_device_id atc260x_ids[] = {
+	{ .driver_info = 1 },
+	{ },
+};
+
+static struct input_handler atc260x_handler = {
+	.event		= atc260x_event,
+	.connect	= atc260x_connect,
+	.disconnect	= atc260x_disconnect,
+	.name		= "atc260x_handler",
+	.id_table	= atc260x_ids,
+};
+
+/**
+ * @brief Registers the gamepad device, its driver and the KEY_POWER input handler.
+ * @return 0.
+ */
+static int __init gpio_key_init(void)
+{
+	platform_device_register(&gpio_keys_polled_device);
+	platform_driver_register(&gpio_keys_polled_driver);
+	if (input_register_handler(&atc260x_handler))
+		pr_warn(DRV_NAME ": atc260x_handler not registered\n");
+	return 0;
+}
+
+/**
+ * @brief Unregisters what gpio_key_init registered.
+ */
+static void __exit gpio_key_exit(void)
+{
+	input_unregister_handler(&atc260x_handler);
+	platform_device_unregister(&gpio_keys_polled_device);
+	platform_driver_unregister(&gpio_keys_polled_driver);
+}
+
+#ifdef MODULE
+module_init(gpio_key_init);
+#else
+/*
+ * Built in: after every other input device (atc260x_onoff is device_initcall and links after this file;
+ * deferred probes are flushed at late_initcall), so the gamepad stays /dev/input/event1 as with the module
+ * (evmapy event1.json configs, test kits).
+ */
+late_initcall_sync(gpio_key_init);
+#endif
+module_exit(gpio_key_exit);
 
