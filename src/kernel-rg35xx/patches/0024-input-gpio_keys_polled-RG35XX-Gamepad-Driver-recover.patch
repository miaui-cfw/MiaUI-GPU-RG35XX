+/** Number of entries in keypad_scancodes. */
+#define RG35XX_NBUTTONS		22
+/* D-pad button codes of later kernels (linux/input.h 3.13+), the values the original reports */
+#ifndef BTN_DPAD_UP
+#define BTN_DPAD_UP		0x220
+#define BTN_DPAD_DOWN		0x221
+#define BTN_DPAD_LEFT		0x222
+#define BTN_DPAD_RIGHT		0x223
+#endif
+/** Highest value accepted by the "volume" class (allen_adjust_volume takes 0..63). */
+#define RG35XX_VOLUME_MAX	40
 
+/**
+ * @brief Driver state: the polled device, its parent, the key map and the pressed bit mask of the last poll
+ *        (bit i = pdata->buttons[i] pressed).
+ */
 struct gpio_keys_polled_dev {
 	struct input_polled_dev *poll_dev;
 	struct device *dev;
