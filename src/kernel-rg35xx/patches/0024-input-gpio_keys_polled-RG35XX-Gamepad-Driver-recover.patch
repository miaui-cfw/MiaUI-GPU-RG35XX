+/**
+ * @brief Bit mask of the first key map button on a GPIO.
+ * @param pdata The key map.
+ * @param gpio The GPIO number.
+ * @return BIT(index), or 0 if no button uses @p gpio.
+ */
+static u32 gpio_keys_polled_gpio_mask(const struct gpio_keys_platform_data *pdata, unsigned int gpio)
+{
+	int i;
+
+	for (i = 0; i < pdata->nbuttons; i++)
+		if (pdata->buttons[i].gpio == gpio)
+			return 1 << i;
+	return 0;
 }
 
+/**
+ * @brief Poll: reads every button (pressed = GPIO low), reports the changed ones, then (until done once)
+ *        detects the board revision: if all of GPIO 16, 19, 20 read pressed, that set (14, 15, 16, 19, 20) is
+ *        the unused one, else if all of GPIO 71, 72, 73 do, the set 71, 72, 73, 84, 85 is; the unused set is
+ *        masked from then on and its codes are released. One input_sync per poll with events.
+ * @param dev The polled device.
+ */
 static void gpio_keys_polled_poll(struct input_polled_dev *dev)
 {
 	struct gpio_keys_polled_dev *bdev = dev->private;
 	const struct gpio_keys_platform_data *pdata = bdev->pdata;
 	struct input_dev *input = dev->input;
-	int i;
+	u32 state = 0, changed;
+	int i, events = 0;
 
-	for (i = 0; i < pdata->nbuttons; i++) {
-		struct gpio_keys_button_data *bdata = &bdev->data[i];
+	for (i = 0; i < pdata->nbuttons; i++)
+		if (!gpio_get_value(pdata->buttons[i].gpio))
+			state |= 1 << i;
+	state &= ~bad_button_mask;
+	changed = bdev->state ^ state;
 
-		if (bdata->count < bdata->threshold)
-			bdata->count++;
-		else
-			gpio_keys_polled_check_state(input, &pdata->buttons[i],
-						     bdata);
+	for (i = 0; i < pdata->nbuttons; i++) {
+		if ((changed & (1 << i)) && pdata->buttons[i].code) {
+			input_event(input, EV_KEY, pdata->buttons[i].code, !!(state & (1 << i)));
+			events++;
+		}
 	}
+	bdev->state = state;
+
+	if (!switched) {
+		u32 set_a, test_a, set_b, test_b;
+		bool a_pressed, b_pressed;
+
+		test_a = gpio_keys_polled_gpio_mask(pdata, 16) | gpio_keys_polled_gpio_mask(pdata, 20) |
+			 gpio_keys_polled_gpio_mask(pdata, 19);
+		set_a = gpio_keys_polled_gpio_mask(pdata, 14) | gpio_keys_polled_gpio_mask(pdata, 15) | test_a;
+		test_b = gpio_keys_polled_gpio_mask(pdata, 71) | gpio_keys_polled_gpio_mask(pdata, 72) |
+			 gpio_keys_polled_gpio_mask(pdata, 73);
+		set_b = gpio_keys_polled_gpio_mask(pdata, 85) | gpio_keys_polled_gpio_mask(pdata, 84) | test_b;
+		a_pressed = !(test_a & ~bdev->state);
+		b_pressed = !(test_b & ~bdev->state);
+
+		if (a_pressed || b_pressed) {
+			bad_button_mask = a_pressed ? set_a : set_b;
+			input_event(input, EV_KEY, BTN_START, 0);
+			input_event(input, EV_KEY, BTN_SELECT, 0);
+			input_event(input, EV_KEY, BTN_MODE, 0);
+			input_event(input, EV_KEY, BTN_THUMBL, 0);
+			input_event(input, EV_KEY, BTN_THUMBR, 0);
+			switched = 1;
+			events += 5;
+		}
+	}
+
+	if (events)
+		input_sync(input);
 }
 
