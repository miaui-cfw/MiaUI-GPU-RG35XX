+/*
+ * RG35XX key map. Entries 8, 9, 14-16 and 17-21 are the same five buttons (START, SELECT, MENU, L3, R3) on
+ * the two board revisions; the unused set reads pressed and is masked on the first poll (see
+ * gpio_keys_polled_poll). The order sets the evdev key order, i.e. the SDL button numbers of the
+ * "RG35XX Gamepad" mapping in gamecontrollerdb.txt: do not reorder.
+ */
+static struct rg35xx_key keypad_scancodes[RG35XX_NBUTTONS] = {
+	{  86, BTN_DPAD_UP,    1 },
+	{  89, BTN_DPAD_DOWN,  1 },
+	{  88, BTN_DPAD_LEFT,  1 },
+	{  87, BTN_DPAD_RIGHT, 1 },
+	{  91, BTN_A,          1 },
+	{  92, BTN_B,          1 },
+	{  90, BTN_X,          1 },
+	{  93, BTN_Y,          1 },
+	{  14, BTN_START,      1 },
+	{  15, BTN_SELECT,     1 },
+	{ 114, BTN_TL,         1 },
+	{ 116, BTN_TR,         1 },
+	{ 117, BTN_TL2,        1 },
+	{ 115, BTN_TR2,        1 },
+	{  16, BTN_MODE,       1 },
+	{  20, BTN_THUMBL,     1 },
+	{  19, BTN_THUMBR,     1 },
+	{  85, BTN_START,      1 },
+	{  84, BTN_SELECT,     1 },
+	{  71, BTN_MODE,       1 },
+	{  72, BTN_THUMBL,     1 },
+	{  73, BTN_THUMBR,     1 },
+};
 
-	if (state != bdata->last_state) {
-		unsigned int type = button->type ?: EV_KEY;
+/** Last KEY_POWER value seen on any input device (atc260x_event); kept from the original, unused. */
+static int current_power_key_value;
+/** Buttons of the unused board revision set, ignored by the poll. */
+static u32 bad_button_mask;
+/** Set once the board revision is detected. */
