 		{
-			gather_battery_info(info);
-			calc_ocv(info);//calc batv,bati,ocv for log
+			info->soc_now = FULL_CHARGE_SOC - 1000;
+			printk("====ocv=%d, rechaging=======\n", info->ocv);
 		}
 		return 0;
 	}
 
-	gather_battery_info(info);
-	calc_ocv(info);
 	calc_soc(info, info->ocv, &info->soc_real);  
 	/* 1.when the load capacity of adapter cannot support charging with more than 60mA,
 	 * 2.when full_power_dealing finished,and then turn on charger ,but also,the load capacity is not enough,
@@ -2605,7 +2635,7 @@ static void gauge_update(struct work_struct *work)
 	get_charge_status(&info->status);
 	if (charge_status ^ info->status)
 	{
-//		GAUGE_INFO("charge status changed!\n");//remove by bill
+		GAUGE_INFO("charge status changed!\n");
 		start_anew(info);  
 		if (info->status == POWER_SUPPLY_STATUS_DISCHARGING)
 			update_discharge_resistor(info,info->soc_now);
@@ -2694,11 +2724,68 @@ int get_cap_gauge(void)
 	return global_gauge_info_ptr->soc_show;
 }
 
+/* REMCON ADC value -> battery temperature: entry i is the lowest ADC value at (i - 30) C, -30..70 C */
+static const int remcon_adc_temp[101] = {
+	981, 977, 972, 968, 963, 959, 954, 949, 943, 938, 932, 926, 920, 914, 908, 901, 894, 887, 880, 873,
+	865, 858, 850, 842, 834, 825, 817, 808, 799, 790, 781, 772, 762, 753, 743, 734, 724, 714, 704, 694,
+	683, 673, 663, 653, 642, 632, 622, 611, 601, 590, 580, 570, 559, 549, 539, 529, 518, 508, 498, 489,
+	479, 469, 459, 450, 441, 431, 422, 413, 404, 395, 387, 378, 370, 361, 353, 345, 337, 330, 322, 315,
+	307, 300, 293, 286, 279, 273, 266, 260, 254, 248, 242, 236, 230, 225, 219, 214, 209, 204, 199, 194,
+	189,
+};
+
+/**
+ * @brief Battery temperature for the charger (act260x_set_get_temp_point), recovered from the installed vendor
+ *        gauge: 5 reads of the bat_temp_channel ADC, minimum and maximum dropped, the mean of the other 3 looked up
+ *        in remcon_adc_temp.
+ * @return The temperature in C (-30..71), or -1000 when support_battery_temperature is off or the ADC fails or
+ *         is out of range (the charger ignores readings below -100 C).
+ */
+static int get_battery_temperature(void)
+{
+	struct atc260x_gauge_info *info = global_gauge_info_ptr;
+	int sum = 0, max = 0, min = 1024;
+	int adc, temp, i;
+
+	if (!info->cfg_items.support_battery_temperature)
+		return -1000;
+	for (i = 0; i < 5; i++)
+	{
+		if (atc260x_auxadc_get_translated(info->atc260x, info->cfg_items.bat_temp_channel, &adc))
+		{
+			GAUGE_ERR("get icm translated fail!!\n");
+			return -1000;
+		}
+		sum += adc;
+		if (adc > max)
+			max = adc;
+		if (adc <= min)
+			min = adc;
+	}
+	adc = (sum - min - max) / 3;
+	if (adc < 40 || adc > 1000)
+	{
+		GAUGE_INFO("err,invalid adc=%d , pelase check bat temp sensor\n", adc);
+		return -1000;
+	}
+	if (adc > 980)
+		temp = -30;
+	else
+	{
+		for (i = 1; i < 101 && adc < remcon_adc_temp[i]; i++)
+			;
+		temp = i - 30;
+	}
+	GAUGE_INFO("adc=%d ,temp=%d C\n", adc, temp);
+	return temp;
+}
+
 static void set_callback(void)
 {
 	act260x_set_get_cap_point((void *)get_cap_gauge);
 	act260x_set_get_volt_point((void *)measure_vbatt);
 	act260x_set_get_cur_point((void *)measure_current);
+	act260x_set_get_temp_point((void *)get_battery_temperature);
 }
 
 void gauge_reset(struct atc260x_gauge_info *info)
@@ -3047,6 +3134,28 @@ static  int atc260x_gauge_probe(struct platform_device *pdev)
 	register_early_suspend(&info->early_suspend);
 #endif
 
+	if (info->cfg_items.support_battery_temperature)
+	{
+		const char *chan;
+
+		ret = of_property_read_string(info->node, "bat_temp_channel", &chan);
+		if (ret >= 0)
+		{
+			info->cfg_items.bat_temp_channel = atc260x_auxadc_find_chan(info->atc260x, chan);
+			GAUGE_INFO("bat_temp_channel: use %s\n", chan);
+		}
+		else
+		{
+			info->cfg_items.bat_temp_channel = atc260x_auxadc_find_chan(info->atc260x, "REMCON");
+			GAUGE_INFO("bat_temp_channel: use defualt REMCON\n");
+		}
+		if (info->cfg_items.bat_temp_channel < 0)
+		{
+			info->cfg_items.support_battery_temperature = 0;
+			GAUGE_WARNING("bat_temp_channel cfg err!\n");
+		}
+	}
+
 	/*Create a work queue for fuel gauge*/
 	info->wq =
 		create_singlethread_workqueue("atc260x_gauge_wq");
@@ -3139,10 +3248,23 @@ static struct platform_driver atc260x_gauge_driver = {
 static int __init atc260x_gauge_init(void)
 {
 	GAUGE_INFO("========This is a new reconstructed gauge by actions==========\n");
+#ifdef MODULE
 	GAUGE_INFO("[%s] drv name:%s, drv version:%s\n", __func__, THIS_MODULE->name, THIS_MODULE->version);
+#else
+	/* built in, THIS_MODULE is NULL */
+	GAUGE_INFO("[%s] drv name:%s (built in)\n", __func__, KBUILD_MODNAME);
+#endif
 	return platform_driver_register(&atc260x_gauge_driver);
 }
+/*
+ * RG35XX: built in, register after the charger (atc260x_power, late_initcall): its act260x_set_get_*_point()
+ * hooks drop the callbacks while global_power_dev is NULL.
+ */
+#ifdef MODULE
 module_init(atc260x_gauge_init);
+#else
+late_initcall_sync(atc260x_gauge_init);
+#endif
 
 static void __exit atc260x_gauge_exit(void)
 {
