 		}
 
@@ -1542,6 +1560,7 @@ static int calc_charge_resistor(struct atc260x_gauge_info *info)
 		if (ret)
 		{
 			GAUGE_ERR("[%s]filter_process failed!\n",__func__);
+			atc260x_set_charger_current(reg_chg_current, &ret);
 			goto out;
 		}
 
@@ -1550,7 +1569,7 @@ static int calc_charge_resistor(struct atc260x_gauge_info *info)
 	}
 	else
 	{
-		reg_chg_current = get_chg_current_now();
+		/* RG35XX (vendor gauge): the charge current is not touched here, only the charger switched */
