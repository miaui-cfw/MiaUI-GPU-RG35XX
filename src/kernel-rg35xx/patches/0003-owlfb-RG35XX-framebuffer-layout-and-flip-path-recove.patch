 	struct owlfb_device *fbdev = ofbi->fbdev;
 	int rc = -1;
 	
+	/* RG35XX: remembered for owlfb_pan_display() */
+	overlay_disable_required = !enable;
+
 	if(ovl_id == OWLFB_CURSOR_OVL_ID)
 	{
 		struct owl_cursor_info cursor;
