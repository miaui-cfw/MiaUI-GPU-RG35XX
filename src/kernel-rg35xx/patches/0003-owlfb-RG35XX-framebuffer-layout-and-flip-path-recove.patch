 #endif
 
 static int owlfb_fb_init(struct owlfb_device *fbdev, struct fb_info *fbi);
+
+/* RG35XX: see owlfb_set_overlay_enable(); pan_display re-applies overlay 1 only while this is set */
+int overlay_disable_required;
