 	{
 		headphone_sdev.name = "h2w";
 		ret = switch_dev_register(&headphone_sdev);
@@ -2360,8 +2467,14 @@ static int __init atc2603c_init(void)
     		{
     			snd_err("failed to device_create_file\n");
         	}
-		
-			
+
+
+	}
