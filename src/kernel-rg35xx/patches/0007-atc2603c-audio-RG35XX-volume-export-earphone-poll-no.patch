 }
 
+/**
+ * @brief RG35XX: init_work handler, the card set-up once the codec and PMU drivers have probed.
+ * @param work init_work.
+ */
+static void init_work_handler(struct work_struct *work)
+{
+	atm7059_link_setup();
+}
+
+static DECLARE_WORK(init_work, init_work_handler);
+
+/**
+ * @brief Module init. RG35XX: like the running kernel, the card is set up from a work item instead of here.
+ * @return 0.
+ */
+static int __init atm7059_link_init(void)
+{
+	printk(KERN_INFO "atm7059_link_init\n");
+	schedule_work(&init_work);
+	return 0;
+}
+
 static void __exit atm7059_link_exit(void)
 {
 	int i = 0;
 
+	flush_work(&init_work);
+
 	for (i = 0; i < ARRAY_SIZE(link_attr); i++) {
 		device_remove_file(&atm7059_link_snd_device->dev, &link_attr[i]);
 	}
