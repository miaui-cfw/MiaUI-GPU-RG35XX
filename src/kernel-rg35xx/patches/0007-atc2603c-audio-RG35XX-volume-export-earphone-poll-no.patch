+		gpio_direction_output(speaker_gpio_num, !speaker_gpio_active);
 /*
 	snd_soc_write(atc2603c_codec, DAC_VOLUMECTL0, 0xBEBE);
 	snd_soc_write(atc2603c_codec, DAC_ANALOG1, 0x0);
@@ -2212,10 +2297,31 @@ static int atc2603c_get_cfg(void)
 	speaker_gpio_active = (speaker_gpio_level & OF_GPIO_ACTIVE_LOW);
 			
 	earphone_gpio_num = of_get_named_gpio_flags(dn, earphone_detect_gpio, 0, NULL);
-	if (earphone_gpio_num < 0) {
+	earphone_gpio_num_new = of_get_named_gpio_flags(dn, earphone_detect_gpio_new, 0, NULL);
+	if (earphone_gpio_num < 0 && earphone_gpio_num_new < 0) {
 		snd_dbg("no earphone detect gpio\r\n");
 	}
-	
+
+	/* RG35XX: method 3 polls both detect pins (one per board revision); either may be missing */
+	if (audio_hw_cfg.earphone_detect_method == 3 && (earphone_gpio_num > 0 || earphone_gpio_num_new > 0)) {
+		int err = gpio_request(earphone_gpio_num, "earphone_dect");
+		int err_new = gpio_request(earphone_gpio_num_new, "earphone_dect_new");
+
+		if (err && err_new) {
+			printk(KERN_ERR "gpio_request of earphone error: err=%d\n", err);
+			return err;
+		}
+		err = err ? err : gpio_direction_input(earphone_gpio_num);
+		err_new = err_new ? err_new : gpio_direction_input(earphone_gpio_num_new);
+		if (err && err_new) {
+			printk(KERN_ERR "gpio_direction_input of earphone error: err=%d\n", err);
+			gpio_free(earphone_gpio_num);
+			gpio_free(earphone_gpio_num_new);
+			earphone_gpio_num = -1;
+			earphone_gpio_num_new = -1;
+		}
+	}
+
 
 	return 0;
 of_get_failed:
@@ -2346,7 +2452,8 @@ static int __init atc2603c_init(void)
 		adc_detect_mode = 0;
 	}
 	
-	if((audio_hw_cfg.earphone_detect_method == 1) || (audio_hw_cfg.earphone_detect_method == 2))
+	/* RG35XX: the codec owns h2w for every detect method but gpio (0), see asoc_earphone_poll() */
