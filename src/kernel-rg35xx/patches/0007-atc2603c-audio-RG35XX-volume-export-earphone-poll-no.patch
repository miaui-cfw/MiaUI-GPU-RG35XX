+/**
+ * @brief RG35XX: earphone_detect_method 3, every 500 ms: reports the headset on h2w and switches the speaker PA.
+ * @param work dwork_poll.
+ *
+ * The earphone is in when a detect pin reads high, except while its board revision's GPIO trio (16, 19, 20 for
+ * earphone_detect_gpios, 71, 72, 73 for earphone_detect_gpios_new) all read low; the DT active flags are not used.
+ * Same logic as the running kernel.
+ */
+static void asoc_earphone_poll(struct work_struct *work)
+{
+	bool masked = !gpio_get_value(16) && !gpio_get_value(19) && !gpio_get_value(20);
+	bool masked_new = !gpio_get_value(71) && !gpio_get_value(72) && !gpio_get_value(73);
+	bool in = false;
+
+	if (gpio_is_valid(earphone_gpio_num) && gpio_get_value(earphone_gpio_num) && !masked)
+		in = true;
+	if (gpio_is_valid(earphone_gpio_num_new) && gpio_get_value(earphone_gpio_num_new) && !masked_new)
+		in = true;
+
+	switch_set_state(&headphone_sdev, in);
+	if (speaker_gpio_num >= 0) {
+		if (in && allen_enable_spk) {
+			gpio_direction_output(speaker_gpio_num, !speaker_gpio_active);
+			allen_enable_spk = 0;
+		} else if (!in && !allen_enable_spk) {
+			gpio_direction_output(speaker_gpio_num, speaker_gpio_active);
+			allen_enable_spk = 1;
+		}
+	}
+	queue_delayed_work(system_wq, &dwork_poll, msecs_to_jiffies(500));
+}
+
 static int atc2603c_remove(struct snd_soc_codec *codec)
 {
 	if (earphone_irq != -1)
@@ -1672,6 +1752,8 @@ static int atc2603c_remove(struct snd_soc_codec *codec)
 	{
