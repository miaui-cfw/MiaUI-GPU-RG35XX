 static int atc2603c_playback_set_controls(struct snd_soc_codec *codec)
 {
-  
+    snd_soc_update_bits(codec, DAC_ANALOG1, 0x3f << DAC_ANALOG1_VOLUME_SFT, allen_volume << DAC_ANALOG1_VOLUME_SFT);
+    snd_soc_update_bits(codec, DAC_VOLUMECTL0, 0xff << DAC_VOLUMECTL0_DACFL_VOLUME_SFT, DAC_VOLUMECTL0_DACFL_VOLUME(0xb5));
+    snd_soc_update_bits(codec, DAC_VOLUMECTL0, 0xff << DAC_VOLUMECTL0_DACFR_VOLUME_SFT, DAC_VOLUMECTL0_DACFR_VOLUME(0xb5));
     snd_soc_update_bits(codec, DAC_ANALOG3, 0x1 << DAC_ANALOG3_PAEN_FR_FL_SFT, 0x01 << DAC_ANALOG3_PAEN_FR_FL_SFT);
     snd_soc_update_bits(codec, DAC_ANALOG3, 0x1 << DAC_ANALOG3_PAOSEN_FR_FL_SFT, 0x01 << DAC_ANALOG3_PAOSEN_FR_FL_SFT);
     snd_soc_update_bits(codec, DAC_DIGITALCTL, 0x03 << DAC_DIGITALCTL_DEFL_SFT, 0x03 << DAC_DIGITALCTL_DEFL_SFT);
-  
+    snd_soc_update_bits(codec, DAC_ANALOG1, 0x1 << DAC_ANALOG1_PASW_SFT, 0x1 << DAC_ANALOG1_PASW_SFT);
+
     snd_soc_update_bits(codec, DAC_ANALOG3, 0x03 << 0, 0x03);
+    return 0;
+}
+
+/**
+ * @brief RG35XX: reads or sets the DAC PA volume (exported for the gpio_keys_polled gamepad module).
+ * @param write 1 to set @p value, 0 to read.
+ * @param value New volume, 0..63 (only with @p write).
+ * @return The current volume when reading (or the register read error), 0 after a write.
+ */
+int allen_adjust_volume(int write, int value)
+{
+	int ret;
+
+	ret = atc260x_reg_read(atc260x, DAC_ANALOG1 + REG_BASE);
+	if (ret < 0) {
+		printk("atc2603c_read: ret = %d failed\n", ret);
+		return write ? 0 : ret;
+	}
+	if (!write)
+		return ret & 0x3f;
+
+	value &= 0x3f;
+	ret = atc260x_reg_write(atc260x, DAC_ANALOG1 + REG_BASE, (ret & 0xffc0) | value);
+	if (ret < 0)
+		printk("atc2603c_write: ret = %d failed\n", ret);
+	allen_volume = value;
+	return 0;
 }
+EXPORT_SYMBOL(allen_adjust_volume);
 
 static int atc2603c_capture_set_controls(struct snd_soc_codec *codec)
