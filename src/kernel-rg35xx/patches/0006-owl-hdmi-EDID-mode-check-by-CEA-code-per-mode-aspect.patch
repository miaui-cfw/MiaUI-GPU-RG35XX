@@ -291,10 +291,6 @@ static int hdmi_get_vid_by_times(struct owl_video_timings * times)
 	 return -1;
 }
 
-static bool hdmi_check_vid_available(int vid)
-{
-	return (((hdmi.edid.video_formats[0] >> vid) & 0x01)==1);
-}
 static int hdmi_get_code_by_vid(int vid)
 {
      int i = 0;
@@ -305,6 +301,35 @@ static int hdmi_get_code_by_vid(int vid)
 	 }
 	 return -1;
 }
+
+/**
+ * @brief RG35XX: AVI picture aspect of a mode.
+ * @param vid OWL_TV_MOD_* of the mode.
+ * @return HDMI_ASPECT_* from cea_timings, or -1 for an unknown vid.
+ */
+static int hdmi_get_aspect_by_vid(int vid)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cea_timings); i++)
+		if (cea_timings[i].cm.vid == vid)
+			return cea_timings[i].cm.aspect;
+	return -1;
+}
+
+/**
+ * @brief Whether the sink's EDID lists a mode.
+ * @param vid OWL_TV_MOD_* of the mode.
+ * @return true when the CEA code of @p vid is set in the EDID video format bitmap.
+ *
+ * RG35XX: the bitmap is indexed by CEA code; the public source shifted it by the vid enum.
+ */
+static bool hdmi_check_vid_available(int vid)
+{
+	int code = hdmi_get_code_by_vid(vid);
+
+	return code >= 0 && code < 32 && ((hdmi.edid.video_formats[0] >> code) & 0x01);
+}
 static bool  is_hdmi_power_on(void)
 {
 	return ((hdmihw_read_reg(HDMI_CR) & 0x01) != 0);
@@ -460,10 +485,11 @@ static int hdmi_probe_pdata(struct platform_device *pdev)
 
 static int check_best_vid_from_edid(struct hdmi_edid *edid)
 {
-	int best_vid;
+	int best_vid = OWL_TV_MOD_DVI;	/* RG35XX: defined when the EDID lists no known mode */
 	int i = 0;	
 	
-	if(boot_hdmi_vid != -1)	{
+	/* RG35XX: the boot mode is kept only if the sink supports it */
+	if(boot_hdmi_vid != -1 && hdmi_check_vid_available(boot_hdmi_vid))	{
 		
 		best_vid =  boot_hdmi_vid;
 		boot_hdmi_vid = -1;
@@ -489,6 +515,7 @@ static int check_best_vid_from_edid(struct hdmi_edid *edid)
 		}
 	}
 		
+	DEBUG_ERR("best_vid is %d\n", best_vid);
 	hdmi.ip_data.cfg.cm.vid = best_vid;
 	
 	return best_vid;
@@ -646,6 +673,7 @@ void owldss_hdmi_display_set_timing(struct owl_dss_device *dssdev,struct owl_vid
 	}	
 	hdmi.ip_data.cfg.cm.vid = vid;
 	hdmi.ip_data.cfg.cm.code = hdmi_get_code_by_vid(vid);
+	hdmi.ip_data.cfg.cm.aspect = hdmi_get_aspect_by_vid(vid);	/* RG35XX */
 	hdmi.ip_data.cfg.cm.mode = hdmi.edid.isHDMI;	
 	
 	mutex_unlock(&hdmi.lock);
@@ -668,6 +696,7 @@ void owldss_hdmi_display_set_vid(struct owl_dss_device *dssdev,int vid)
 	}	
 	hdmi.ip_data.cfg.cm.vid = vid;
 	hdmi.ip_data.cfg.cm.code = hdmi_get_code_by_vid(vid);
+	hdmi.ip_data.cfg.cm.aspect = hdmi_get_aspect_by_vid(vid);	/* RG35XX */
 	hdmi.ip_data.cfg.cm.mode = hdmi.edid.isHDMI;	
 	DEBUG_ON("owldss_hdmi_display_set_vid vid %d ,code %d mode %d  \n",hdmi.ip_data.cfg.cm.vid,hdmi.ip_data.cfg.cm.code,hdmi.ip_data.cfg.cm.mode);
 	mutex_unlock(&hdmi.lock);
@@ -1034,12 +1063,11 @@ static int of_get_hdmi_data(struct platform_device *pdev, struct hdmi_property *
 		
 	}
 	
-	if (of_property_read_string(of_node, "default_resolution", &default_resulation)) {
-		default_resulation = NULL;
-		//DEBUG_ON("cat not get bit_invert  %d\n", hdmi_data->bit_invert);
-	}
-	
-	user_config_vid = string_to_data_fmt(default_resulation);
+	/* RG35XX: without the property there is no user mode (the public source looked up a NULL name) */
+	if (of_property_read_string(of_node, "default_resolution", &default_resulation))
+		user_config_vid = -1;
+	else
+		user_config_vid = string_to_data_fmt(default_resulation);
 	
 	if(boot_hdmi_vid == -1)
 	{
