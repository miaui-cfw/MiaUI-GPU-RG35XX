 			false, 1, 0, },
-		{ 31, HDMI_HDMI,OWL_TV_MOD_1080P_50HZ },
+		{ 31, HDMI_HDMI,OWL_TV_MOD_1080P_50HZ, HDMI_ASPECT_16_9 },
 	},
