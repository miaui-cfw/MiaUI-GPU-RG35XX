+/**
+ * @brief Reads one temperature item of the RG35XX battery temperature control from the power DT node.
+ * @param charger The charger (its DT node).
+ * @param name    DT property.
+ * @param def     Value when the property is absent.
+ * @return Degrees C; DT values above 1000 encode negatives (1000 - value).
+ */
+static int atc260x_get_temp_item(struct atc260x_charger *charger, const char *name, int def)
+{
+	int len;
+	const __be32 *property = of_get_property(charger->node, name, &len);
+	int value;
