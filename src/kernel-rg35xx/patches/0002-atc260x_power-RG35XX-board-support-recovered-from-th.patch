+/**
+ * @brief Sets the work and low-battery LED pairs.
+ * @param work Value of both work LED pins.
+ * @param low  Value of both low-battery LED pins.
+ */
+static void set_my_work_led(int work, int low)
+{
+	board_gpio_set(work_led_pin, work);
+	board_gpio_set(work_led_pin_new, work);
+	board_gpio_set(low_led_pin, low);
+	board_gpio_set(low_led_pin_new, low);
+}
+
+/**
+ * @brief The 500 ms board poll: OTG power switch from the ID pin, then the LEDs (factory blink test, charger boot
+ *        mode, external power, low battery at 1..11% or at 0% with <= 3499 mV, else normal). Requeues itself.
+ * @param work charger->led_work.
+ */
+static void allen_led_poll(struct work_struct *work)
+{
+	struct atc260x_charger *charger = container_of(to_delayed_work(work), struct atc260x_charger, led_work);
+	int active_low = charger->cfg_items.gpio_led_active_low;
+
+	if (otg_id_pin >= 0) {
+		int id = gpio_get_value(otg_id_pin);
+
+		if (!id && otg_state == 1) {
+			printk(KERN_ERR "--allen--<%s> otg out \n", "set_my_vbus_switch");
+			otg_state = 0;
+			board_gpio_set(otg_2_pin, 0);
+		} else if (id && otg_state == 0) {
+			printk(KERN_ERR "--allen--<%s> otg insert \n", "set_my_vbus_switch");
+			otg_state = 1;
+			board_gpio_set(otg_2_pin, 1);
+		}
+	}
+
+	if (led_test_flg == 1) {
+		if (++led_test_counter == 2) {
+			set_my_work_led(work_led_level, low_led_level);
+			if (charger->cfg_items.charger_led_exist) {
+				board_gpio_set(charger->cfg_items.gpio_led_inner_pin, active_low);
+				board_gpio_set(charger->cfg_items.gpio_led_inner_pin_new, active_low);
+			}
+		} else if (led_test_counter == 4) {
+			led_test_counter = 0;
+			set_my_work_led(!work_led_level, !low_led_level);
+			if (charger->cfg_items.charger_led_exist) {
+				board_gpio_set(charger->cfg_items.gpio_led_inner_pin, !active_low);
+				board_gpio_set(charger->cfg_items.gpio_led_inner_pin_new, !active_low);
+			}
+		}
+	} else if (charger->bat_is_exist) {
+		if (owl_get_boot_mode() != OWL_BOOT_MODE_CHARGER) {
+			int cap = charger->cur_bat_cap;
+
+			if (charger->charge_on || charger->wall_mv > 3600) {
+				if (my_led_status != 1) {
+					printk("--allen--<%s> 11111 my_led_status=%d \n", "set_my_work_led", my_led_status);
+					my_led_status = 1;
+					set_my_work_led(work_led_level, !low_led_level);
+				}
+			} else if ((cap >= 1 && cap <= 11) || (cap == 0 && charger->bat_mv <= 3499)) {
+				if (my_led_status != 2) {
+					printk("--allen--<%s> 22222,cur_bat_cap=%d,bat_mv=%d \n", "set_my_work_led",
+					       cap, charger->bat_mv);
+					my_led_status = 2;
+					set_my_work_led(!work_led_level, low_led_level);
+				}
+			} else if (my_led_status != 0) {
+				printk("--allen--<%s> 00000,my_led_status=%d \n", "set_my_work_led", my_led_status);
+				my_led_status = 0;
+				set_my_work_led(work_led_level, !low_led_level);
+			}
+		}
+		set_my_charg_led(charger);
+	}
+	queue_delayed_work(system_wq, &charger->led_work, msecs_to_jiffies(500));
 }
 
