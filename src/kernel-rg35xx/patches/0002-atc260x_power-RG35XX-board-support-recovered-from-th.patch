+/**
+ * @brief Requests a board GPIO and sets its direction.
+ * @param pin   GPIO number from the DT, < 0 when absent.
+ * @param label gpio_request label.
+ * @param value Initial output value, or -1 for an input.
+ * @return The GPIO number, or -1 when absent or already taken.
+ */
+static int board_gpio_claim(int pin, const char *label, int value)
+{
+	if (pin < 0)
+		return -1;
+	if (gpio_request(pin, label) < 0) {
+		power_err("[ATC260X] %s =%d request failed!\n", label, pin);
+		return -1;
+	}
+	if (value < 0)
+		gpio_direction_input(pin);
+	else
+		gpio_direction_output(pin, value);
+	return pin;
+}
