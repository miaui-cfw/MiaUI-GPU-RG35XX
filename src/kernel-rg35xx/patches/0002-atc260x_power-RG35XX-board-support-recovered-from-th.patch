+/**
+ * @brief sysfs read of the rumble motor: logs the PWM period (the vendor kernel prints nothing back).
+ * @return 0 (empty read).
+ */
+static ssize_t show_moto(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	if (!moto_pwm)
+		return 0;
+	printk("PWM:priod_ns= %d\n", moto_pwm->period);
+	return 0;
+}
+
+/**
+ * store_moto - sysfs write of the rumble motor strength, 0..100 (larger values are clamped). 0 stops the motor
+ * (duty of 1 ns); n sets the duty to n% of the PWM period.
+ */
+static ssize_t store_moto(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+	unsigned long level = simple_strtoul(buf, NULL, 10);
+
+	pr_err("%s: set moto pwm (%ld) \n", __func__, level);
+	if (!moto_pwm)
+		return count;
+	if (level == 0) {
+		pwm_config(moto_pwm, 1, moto_pwm->period);
+		return count;
+	}
+	if (level > 100)
+		level = 100;
+	pwm_config(moto_pwm, moto_pwm->period * level / 100, moto_pwm->period);
+	return count;
+}
