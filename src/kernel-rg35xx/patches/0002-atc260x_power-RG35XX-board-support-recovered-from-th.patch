+/**
+ * @brief RG35XX battery temperature control (cfg temp_ctl_enable): powers off, without charger wake-up, outside
+ *        [temp_shutdown_low, temp_shutdown_high]; stops charging outside [temp_stop_low, temp_stop_high] and allows
+ *        it again once temp_diff_restart degrees back inside. Readings below -100 C are ignored.
+ * @param charger The charger.
+ */
+static void check_battery_temperature(struct atc260x_charger *charger)
+{
+	struct atc260x_cfg_items *cfg = &charger->cfg_items;
+	int t = charger->bat_temp;
+
+	if (!charger->bat_is_exist || !cfg->temp_ctl_enable || t < -100)
+		return;
+	power_info("bat temp %d(C)\n", t);
+	if (t > cfg->temp_shutdown_high || t < cfg->temp_shutdown_low)
+	{
+		pr_err("bat temp reached %d(C), shutting down \n", t);
+		owl_force_shutdown();
+		orderly_poweroff(true);
+	}
+	else if (!charger->temp_discharging)
+	{
+		if (t > cfg->temp_stop_high || t < cfg->temp_stop_low)
+		{
+			pr_warn("bat temp =%d C  > %d , < %d, dischargeing\n", t, cfg->temp_stop_high, cfg->temp_stop_low);
+			charger->temp_discharging = true;
+		}
+	}
+	else if (t > cfg->temp_stop_low + cfg->temp_diff_restart && t < cfg->temp_stop_high - cfg->temp_diff_restart)
+	{
+		pr_warn("bat temp =%d C between [%d , %d], rechargeing\n", t,
+			cfg->temp_stop_low + cfg->temp_diff_restart, cfg->temp_stop_high - cfg->temp_diff_restart);
+		charger->temp_discharging = false;
+	}
      
 }
 
